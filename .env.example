# o2Wave — variables de entorno (plantilla)
# Copia este archivo a .env.local y rellena los valores. NO subas .env.local a git.
# Las NEXT_PUBLIC_* se exponen al navegador; el resto son SECRETAS (solo servidor).

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=            # URL pública del sitio, p. ej. https://www.o2wave.app

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=        # URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # clave anónima (pública)
SUPABASE_SERVICE_ROLE_KEY=       # clave service_role (SECRETA, solo servidor/crons)

# ── Stripe (pagos y suscripciones) ────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # clave publicable (pk_...)
STRIPE_SECRET_KEY=               # clave secreta (sk_...)
STRIPE_WEBHOOK_SECRET=           # secreto del webhook (whsec_...)
STRIPE_BETA_COUPON_ID=           # cupón 100% para códigos Beta
STRIPE_COUPON_MENCION_GO2=       # cupón del 10% por mención Go2

# ── Meta / Instagram / Facebook ───────────────────────────────────────────────
META_APP_ID=                     # app de Facebook Login (publicación en páginas)
META_APP_SECRET=
META_REDIRECT_URI=               # callback OAuth de Facebook
META_IG_APP_ID=                  # app de Instagram Login (publicación directa IG)
META_IG_APP_SECRET=
META_IG_REDIRECT_URI=            # callback OAuth de Instagram
TOKEN_ENC_KEY=                   # clave para cifrar los tokens guardados en BD

# ── IA (generación de texto/imagen/vídeo) ─────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
REPLICATE_API_TOKEN=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_EMAIL=              # destinatario de avisos (p. ej. fallos de autopost)

# ── Crons (Vercel) ────────────────────────────────────────────────────────────
CRON_SECRET=                     # Bearer que exige el cron de publicación
CRON_TOKEN=                      # token alternativo de crons

# ── Autopost / Blog → Instagram ───────────────────────────────────────────────
AUTOPOST_ENABLED=                # "true" para activar la publicación automática
BLOG_WP_BASE=                    # base REST del blog, p. ej. https://generacion-o2.org/wp-json/wp/v2
BLOG_IG_CUENTA=                  # etiqueta de la cuenta destino (def. "go2.bcn")
BLOG_IG_DESDE=                   # fecha de corte YYYY-MM-DD (no republica histórico)

# ── Publicación directa multicuenta (flag de despliegue gradual) ──────────────
PUBLICACION_DIRECTA_ABIERTA=     # "true" para abrir a todos los Pro
PUBLICACION_DIRECTA_EMAILS=      # lista de emails permitidos (allowlist), separados por comas
